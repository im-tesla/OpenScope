{
  "name": "openscope",
  "version": "1.0.0",
  "description": "Microscope autofocus workstation",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:start": "electron .",
    "start": "node scripts/dev.mjs",
    "package": "npm run build && npm run electron:build && electron-builder --win",
    "postinstall": "electron-rebuild -f -w serialport"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.17",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
